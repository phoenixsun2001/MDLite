{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDLite",
  "version": "1.0.0",
  "identifier": "com.geoq.mdlite",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MDLite — 轻快的 Markdown 阅读器",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#f7f7f5"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
